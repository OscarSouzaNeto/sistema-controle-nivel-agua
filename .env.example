# Copie este arquivo para ".env" e preencha com os seus valores.
# O arquivo ".env" NÃO deve ser enviado para o GitHub (já está no .gitignore).

PORT=3002

# ThingSpeak
THINGSPEAK_CHANNEL_ID=seu_id_do_canal
THINGSPEAK_READ_API_KEY=sua_chave_de_leitura

# Twilio
TWILIO_ACCOUNT_SID=seu_account_sid
TWILIO_AUTH_TOKEN=seu_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Usado apenas pelo verificador automático de alertas (npm run alerta)
ALERT_RECIPIENT_NUMBER=+55XXXXXXXXXXX
LIMITE_NIVEL_CM=200
